{
  "name": "meeting-sim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "test": "vitest run --coverage",
    "sim": "tsx sim/run.ts",
    "sim:ci": "tsx sim/run.ts --runs 2000 --policy all",
    "e2e": "playwright test",
    "size": "tsx scripts/checkSize.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15",
    "@vercel/analytics": "2.0.1"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "vitest": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "fast-check": "4.10.2",
    "@playwright/test": "1.64.0",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
